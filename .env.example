# Copy to .env (gitignored) and fill in. NEVER commit .env or real values.
# Defaults keep "Stage A" working with no Redis: in-memory cache and rate limits, Postgres (pg-boss) queue, WORKER_MODE=both.

# development | test | production (production additionally requires the Razorpay vars and CORS_ORIGINS)
NODE_ENV=development
# HTTP port the API listens on
PORT=8080
# pino log level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# Postgres 15+ connection string (Supabase works as plain Postgres). Needs extensions pgcrypto, btree_gist, citext
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# true when the host requires TLS (Supabase/Render)
DATABASE_SSL=false
# Optional PEM CA file to trust for TLS (path relative to the repo root), e.g. certs/supabase-prod-ca-2021.crt. TLS is always verified; without a file Node's default trust store is used
DATABASE_SSL_CA_FILE=
# true when DATABASE_URL goes through a transaction pooler (Supabase :6543): no session-level settings, timeouts applied with SET LOCAL per transaction
DB_POOLER=false
# max pooled connections PER INSTANCE (pooler limit / number of instances); DATABASE_POOL_MAX is accepted as an alias
DB_POOL_MAX=10
# per-query statement_timeout in ms (0 disables)
STATEMENT_TIMEOUT_MS=5000
# lock_timeout in ms (0 disables); sent as a startup option, not supported by some transaction poolers
LOCK_TIMEOUT_MS=2000
# idle_in_transaction_session_timeout in ms (0 disables)
IDLE_TX_TIMEOUT_MS=10000

# HS256 signing secret for access tokens, >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-generated-secret-at-least-32-chars
# HMAC secret for booking QR tokens, >= 32 chars, different from JWT_SECRET
QR_SECRET=replace-with-another-generated-secret-32-chars

# Razorpay key id (TEST key until launch; shared account, everything is tagged notes.app=trim)
RAZORPAY_KEY_ID=
# Razorpay key secret
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay webhook (signature check over the raw body)
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated browser origins allowed by CORS (website, admin console). Mobile/desktop apps send no Origin.
CORS_ORIGINS=http://localhost:3000
# Public website base URL, used to build sales invite links
WEBSITE_URL=http://localhost:3000
# Number of reverse proxies in front of the API (Render = 1) so rate limits see the real client IP
TRUST_PROXY=1

# Process model: api (HTTP only), worker (jobs only, tiny health server) or both
WORKER_MODE=both
# false = run jobs inline inside the request (no queue); true = use QUEUE_DRIVER
QUEUE_ENABLED=true
# pgboss (Postgres queue, durable) or memory (in-process, tests/dev only)
QUEUE_DRIVER=pgboss
# Optional DIRECT (non-pooler) connection string for pg-boss when DATABASE_URL points at a transaction pooler
QUEUE_DATABASE_URL=
# Shed optional reads (503 OVERLOADED) when the queue backlog exceeds this
QUEUE_MAX_DEPTH=5000

# memory or redis; redis needs REDIS_URL (cache is optional, never required for correctness)
CACHE_DRIVER=memory
# memory or redis (use redis as soon as you run more than one API instance)
RATE_LIMIT_DRIVER=memory
# Redis connection string, only when a driver above is redis (managed key-value, Stage B+)
REDIS_URL=

# Cache TTLs in seconds (0 disables that cache): plans, service templates + hairstyles, public salon profile, discovery search, availability, session/permission/entitlement rows
CACHE_TTL_PLANS_S=3600
CACHE_TTL_CATALOG_S=86400
CACHE_TTL_SALON_PUBLIC_S=120
CACHE_TTL_DISCOVER_S=45
CACHE_TTL_AVAILABILITY_S=8
CACHE_TTL_ENTITLEMENTS_S=30
CACHE_TTL_SESSION_S=30

# general rate limit per IP per minute
RATE_LIMIT_GENERAL_PER_MIN=300
# login attempts per IP+identifier per 15 minutes
RATE_LIMIT_LOGIN_PER_15MIN=10
# contact-form submissions per IP per hour
RATE_LIMIT_CONTACT_PER_HOUR=5
# customer / owner registrations per IP per hour
RATE_LIMIT_REGISTER_PER_HOUR=5
# availability reads per user (or IP) per minute
RATE_LIMIT_AVAILABILITY_PER_MIN=60
# booking holds per user per minute
RATE_LIMIT_HOLD_PER_MIN=10
# QR check-ins per salon per minute
RATE_LIMIT_CHECKIN_PER_MIN=120

# Slot-hoarding caps per customer: active holds, upcoming confirmed bookings, bookings created in 24 h
MAX_HELD_PER_CUSTOMER=3
MAX_UPCOMING_PER_CUSTOMER=10
MAX_BOOKINGS_PER_DAY=5

# JSON body limit in KB (media upload route uses MEDIA_BODY_LIMIT_KB)
BODY_LIMIT_KB=100
# body limit for POST /media in KB
MEDIA_BODY_LIMIT_KB=400
# request timeout in ms
REQUEST_TIMEOUT_MS=15000

# Load shedding: event-loop lag (ms) and DB pool waiters above which optional reads get 503 (0 disables)
LOAD_SHED_LAG_MS=500
LOAD_SHED_POOL_WAITING=50

# expose GET /metrics (Prometheus text)
METRICS_ENABLED=true
# token for /metrics ("Authorization: Bearer <token>" or "X-Metrics-Token: <token>"). REQUIRED in production while METRICS_ENABLED=true; empty = open (dev/test only)
METRICS_TOKEN=

# shared secret (>= 24 chars) the website server sends as X-Trim-BFF-Key so the API can trust X-Trim-Client-IP for rate limiting. Same value on the website. Empty = headers ignored (all website visitors then share the proxy IP's limits)
BFF_SHARED_SECRET=

# argon2id memory cost in KiB (19456 = OWASP minimum; tests use a tiny value)
ARGON2_MEMORY_KIB=19456

# ---- founding-salon waitlist + e-mail (Brevo SMTP). Mail is disabled (sign-ups still work) while SMTP_USER/SMTP_PASS/MAIL_FROM are empty
# true = POST /v1/waitlist accepts sign-ups; false = 409 WAITLIST_CLOSED
WAITLIST_OPEN=true
# waitlist sign-ups per client IP per hour
RATE_LIMIT_WAITLIST_PER_HOUR=10
# SMTP server host (Brevo relay)
SMTP_HOST=smtp-relay.brevo.com
# SMTP port: 587 with STARTTLS (SMTP_SECURE=false) or 465 with implicit TLS (SMTP_SECURE=true)
SMTP_PORT=587
# true only for implicit TLS (port 465)
SMTP_SECURE=false
# SMTP login shown in Brevo > SMTP & API > SMTP (secret)
SMTP_USER=
# Brevo SMTP key (NOT the API key) (secret)
SMTP_PASS=
# Sender, must be a verified Brevo sender, e.g. "Trim by TokenBurners <waitlist@example.com>"
MAIL_FROM=
# TokenBurners inbox that receives a copy of every waitlist sign-up (empty = no copy)
WAITLIST_NOTIFY_TO=

# ---- MFA (TOTP authenticator app) ----
# AES-256-GCM key for encrypting TOTP secrets, 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty = MFA setup disabled (login still works, existing MFA users cannot add new setups)
MFA_ENCRYPTION_KEY=
# OTP rate limits: max OTPs per email per hour, max OTPs per IP per hour
RATE_LIMIT_OTP_PER_EMAIL_PER_HOUR=5
RATE_LIMIT_OTP_PER_IP_PER_HOUR=20
